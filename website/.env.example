# Public browser configuration only. Copy to .env.local when wiring integration.
# Leave blank for UI review: payment/account APIs are not included or deployed.
VITE_COMMERCE_API_URL=
VITE_AMS_LOGIN_URL=

# Existing Manus Maps proxy: requires an approved frontend credential and
# authorization for the deployment origin. No credential is included.
# The map loader will not function on an independent host until authorized.
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

# Never put Stripe secret keys, Shopify Admin/private access tokens,
# webhook secrets or AMS server credentials in VITE_ variables.
